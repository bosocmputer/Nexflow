PROJECT_NAME=billflow

# Server
PORT=8090
ENV=development

# Database
DATABASE_URL=postgres://billflow:changeme_strong_password@localhost:5438/billflow
DB_USER=billflow
DB_PASSWORD=changeme_strong_password

# JWT (min 32 chars)
JWT_SECRET=your-secret-key-must-be-at-least-32-characters
JWT_EXPIRE_HOURS=24

# LINE OA — REISSUE token/secret ก่อนใช้ทุกครั้ง (Messaging API → Reissue)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=

# SML #1 — JSON-RPC sales routing
SML_BASE_URL=http://192.168.2.213:3248

# SML #2 — REST saleinvoice (Shopee Excel import)
# ⚠️ SHOPEE_SML_UNIT_CODE ห้ามว่าง — SML reject unit_code=""
# ⚠️ SHOPEE_SML_BRANCH_CODE ต้องตรงกับ fiscal period ใน SML
# ค่าที่ confirmed working (2026-04-24): GUID=smlx PROVIDER=SMLGOH DB=SML1_2026
SHOPEE_SML_URL=http://192.168.2.248:8080
SHOPEE_SML_GUID=smlx
SHOPEE_SML_PROVIDER=SMLGOH
SHOPEE_SML_CONFIG_FILE=SMLConfigSMLGOH.xml
SHOPEE_SML_DATABASE=SML1_2026
SHOPEE_SML_BRANCH_CODE=001
SHOPEE_SML_DOC_FORMAT=INV
# cust_code moved to channel_defaults table — manage via /settings/channels.
SHOPEE_SML_SALE_CODE=
SHOPEE_SML_WH_CODE=WH-01
SHOPEE_SML_SHELF_CODE=SH-01
SHOPEE_SML_UNIT_CODE=ถุง
SHOPEE_SML_VAT_TYPE=0
SHOPEE_SML_VAT_RATE=7
SHOPEE_SML_DOC_TIME=09:00

# Shopee Open API direct sync (sandbox first; tokens are stored in DB).
# Use the Test Partner_id/key until Shopee Go-Live is approved.
SHOPEE_OPEN_API_ENABLED=false
SHOPEE_OPEN_API_ENV=sandbox
SHOPEE_OPEN_API_BASE_URL=https://openplatform.sandbox.test-stable.shopee.sg
SHOPEE_OPEN_API_PARTNER_ID=
SHOPEE_OPEN_API_PARTNER_KEY=
# Optional override. Defaults to PUBLIC_BASE_URL + /api/shopee-api/callback
SHOPEE_OPEN_API_REDIRECT_URL=

# SML set products are fail-closed. Enable document expansion only after the
# tenant catalog is synchronized and a controlled SML Desktop comparison passes.
SML_SET_PRODUCT_EXPANSION_ENABLED=false
# Enable set-stock calculation only after a dry-run confirms component units,
# warehouse scope, bottleneck stock, and no shared-component overcommit.
SHOPEE_SET_STOCK_ENABLED=false

# Shopee Realtime / LINE admin notifications
ENABLE_SHOPEE_REALTIME_OPS=false
ENABLE_SHOPEE_RICH_LINE_FLEX=true
ENABLE_SHOPEE_SETTLEMENT_LINE_ALERTS=true
ENABLE_SHOPEE_ORDER_ESCROW_ENRICHMENT=true
ENABLE_SHOPEE_CANCEL_AFTER_SML_ALERTS=true
ENABLE_SHOPEE_SML_CANCEL_DOCUMENTS=false

# Cron
BACKUP_CRON_HOUR=0
DISK_WARN_PERCENT=90
DATA_LIFECYCLE_ENABLED=true
DATA_LIFECYCLE_CRON_HOUR=2
HOT_LOG_DAYS=90
AUTO_ARCHIVE_DAYS=180
SUMMARY_RETENTION_DAYS=730
PURGE_BATCH_SIZE=1000

# Bill artifact storage (original source files for each bill — PDF/HTML/etc.)
# Mounted volume in docker-compose. Cap per-file size to protect disk.
ARTIFACTS_DIR=/app/artifacts
ARTIFACTS_MAX_BYTES=10485760

# Frontend (Vite build-time)
VITE_API_URL=http://localhost:8090
# Sales-only UI. LINE chat, purchase flow, AI and email ingestion are disabled.
VITE_PHASE=99

# Marketplace Product Master rollout. Use shadow for a canary comparison,
# then switch to active after aggregate shadow_mismatch logs are clean.
PRODUCT_MAPPING_MASTER_MODE=active
