FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o tiktok-shop-gateway ./cmd/tiktok-shop-gateway

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /app/tiktok-shop-gateway .
EXPOSE 8092
USER 65532:65532
CMD ["./tiktok-shop-gateway"]
